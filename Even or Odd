import java.util.*;
public class OddEven{
public static void main(String[] args){
Scanner sc=new Scanner(System.in);

int n=sc.nextInt();

int[] a= new int[n];

System.out.println("Enter elements:");

for(int i=0;i<n;i++){
a[i]=sc.nextInt();

if(a[i]%2==0){
System.out.println("Even number"+ a[i]);
}
else{
System.out.println("Odd number"+ a[i]);
}
}
}
}
